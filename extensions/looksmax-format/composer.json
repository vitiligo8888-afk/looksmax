{
  "name": "local/looksmax-format",
  "description": "Post content formatting: XenForo-parity BBCodes (spoilers, unfurl cards, rich quotes, media, tables) rendered as first-class components",
  "type": "flarum-extension",
  "license": "MIT",
  "require": { "flarum/core": "^1.8" },
  "autoload": { "psr-4": { "Local\\Format\\": "src/" } },
  "extra": {
    "flarum-extension": {
      "title": "Looksmax Formatting",
      "category": "feature",
      "optional-dependencies": [
        "flarum/bbcode",
        "flarum/markdown",
        "flarum/mentions",
        "flarum/emoji"
      ],
      "icon": { "name": "fas fa-code", "backgroundColor": "#12161c", "color": "#7aa2f7" }
    }
  }
}
